<?xml version="1.0" encoding="utf-8"?>
<!-- 【1×2】五行平分高度，电流和容量结论都留在格子里。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF151A18">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_bg"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.6"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="76%"
            android:textColor="#F3F6F1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="放电中"
            android:textColor="#A7B2AB" />

        <TextView
            android:id="@+id/widget_current"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="放 480 mA"
            android:textColor="#F3F6F1" />

        <TextView
            android:id="@+id/widget_health"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="健康 96%"
            android:textColor="#D6F25C" />

        <TextView
            android:id="@+id/widget_verdict"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="几乎没有缩减"
            android:textColor="#F3F6F1" />
    </LinearLayout>
</FrameLayout>
