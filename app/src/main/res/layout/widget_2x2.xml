<?xml version="1.0" encoding="utf-8"?>
<!-- 【2×2】电量、电流、功率、电压和容量结论。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_bg"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F3F6F1"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="76%" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A7B2AB"
            android:textSize="13sp"
            tools:text="放电中" />

        <TextView
            android:id="@+id/widget_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#F3F6F1"
            android:textSize="16sp"
            tools:text="放 480 mA" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F3F6F1"
            android:textSize="16sp"
            tools:text="1.9 W" />

        <TextView
            android:id="@+id/widget_voltage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A7B2AB"
            android:textSize="13sp"
            tools:text="4.12 V" />

        <TextView
            android:id="@+id/widget_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F3F6F1"
            android:textSize="13sp"
            tools:text="几乎没有缩减" />
    </LinearLayout>
</FrameLayout>
