<?xml version="1.0" encoding="utf-8"?>
<!-- 【小组件】默认可从 1×1 拉到 2×2。添加时先选背景。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.batterymirror.z70.widget.WidgetConfigureActivity"
    android:description="@string/widget_desc"
    android:initialLayout="@layout/widget_1x1"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="320dp"
    android:previewLayout="@layout/widget_2x2"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
