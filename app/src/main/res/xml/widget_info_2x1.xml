<?xml version="1.0" encoding="utf-8"?>
<!-- 【2×1】标准横条：宽两格，高一格。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.batterymirror.z70.widget.WidgetConfigureActivity"
    android:description="@string/widget_desc_2x1"
    android:initialLayout="@layout/widget_2x1"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="250dp"
    android:resizeMode="horizontal|vertical"
    android:previewImage="@drawable/widget_preview_2x1"
    android:previewLayout="@layout/widget_2x1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
